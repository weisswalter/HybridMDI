<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{34FB616A-1775-43D4-8778-36929CDCFE9D}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="Heisenberg.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Tools\PrjTool.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Tools\PkgTools.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="Heisenberg">
        <MSBuild Projects="Heisenberg.dproj"/>
    </Target>
    <Target Name="Heisenberg:Clean">
        <MSBuild Projects="Heisenberg.dproj" Targets="Clean"/>
    </Target>
    <Target Name="Heisenberg:Make">
        <MSBuild Projects="Heisenberg.dproj" Targets="Make"/>
    </Target>
    <Target Name="PrjTool">
        <MSBuild Projects="Tools\PrjTool.dproj"/>
    </Target>
    <Target Name="PrjTool:Clean">
        <MSBuild Projects="Tools\PrjTool.dproj" Targets="Clean"/>
    </Target>
    <Target Name="PrjTool:Make">
        <MSBuild Projects="Tools\PrjTool.dproj" Targets="Make"/>
    </Target>
    <Target Name="PkgTools">
        <MSBuild Projects="Tools\PkgTools.dproj"/>
    </Target>
    <Target Name="PkgTools:Clean">
        <MSBuild Projects="Tools\PkgTools.dproj" Targets="Clean"/>
    </Target>
    <Target Name="PkgTools:Make">
        <MSBuild Projects="Tools\PkgTools.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="Heisenberg;PrjTool;PkgTools"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="Heisenberg:Clean;PrjTool:Clean;PkgTools:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="Heisenberg:Make;PrjTool:Make;PkgTools:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
